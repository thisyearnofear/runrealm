# RunRealm Environment Variables
# Copy this file to .env and fill in your actual values.
# Do NOT commit real credentials — see scripts/secrets-scan.sh.

# Mapbox Access Token (required for map functionality)
# Get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# Google Generative AI API Key (for AI features)
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_google_api_key_here
# Web3 Configuration (for blockchain features)
PRIVATE_KEY=your_private_key_here
ZETACHAIN_RPC_URL=https://zetachain-athens-evm.blockpi.network/v1/rpc/public

# Phase 3 additive boost contract (deployed on ZetaChain Athens).
RUNREALM_BOOST_ADDRESS=

# --- Zama Protocol FHEVM (confidential territory defense) ---
# Sepolia is the FHEVM host chain. A public RPC is used by default,
# override here for a private endpoint (Infura/Alchemy).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Etherscan v2 API key (optional) — enables `hardhat verify` on Sepolia.
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Deployed ConfidentialTerritoryDefense address (filled after deploy).
RUNREALM_CONFIDENTIAL_DEFENSE_ADDRESS=

# --- Attestation oracle + network leaderboard (optional) ---
# Protocol-vision Layer 3. With a quorum configured, completed runs/ghost
# races are signed as EIP-712 summaries and the leaderboard can merge the
# network-wide board alongside your local one. Leave everything blank and the
# app honestly reports `local` attestations — the local board still works.
#
# SERVER ONLY. The oracle's signing key (32-byte hex, with 0x). Setting it is
# what mounts POST /attestations/sign on server.js. Use a dedicated throwaway
# key, never a wallet holding funds, and never expose it to the browser (no
# NEXT_PUBLIC_*, no __ENV__ bridge) — the key must stay server-side.
RUNREALM_ORACLE_PRIVATE_KEY=
# CLIENT. Comma-separated oracle base URLs. The app POSTs typed data to
# <url>/attestations/sign and reads the board from <url>/attestations/
# leaderboard, so each URL must be reachable from the browser (server.js sends
# Access-Control-Allow-Origin: *).
RUNREALM_ATTESTATION_ORACLES=
# Web app equivalent (apps/web/.env.local). NEXT_PUBLIC_* is inlined at build
# time — restart the dev server after changing it. Public by design: an oracle
# URL is not a credential.
NEXT_PUBLIC_RUNREALM_ATTESTATION_ORACLES=
# SERVER ONLY. Where the network ledger is persisted, atomically, after every
# signature (default: ./.data/attestation-ledger.json, gitignored). It is
# loaded on boot, so a restart resumes the board it was serving. A corrupt file
# is ignored with a warning; a write failure never breaks a signature. Set to
# `off` for a memory-only board that starts empty on restart.
RUNREALM_LEDGER_PATH=

# Feature Flags
ENABLE_WEB3=true
ENABLE_AI_FEATURES=true
ENABLE_CROSS_CHAIN=true
# Sunprint Atlas generated-atmosphere layer. Keep disabled until a server-side
# Reactor token endpoint is configured; REACTOR_API_KEY must never be exposed
# through NEXT_PUBLIC_* or the browser __ENV__ bridge.
ENABLE_ORBIS=false
REACTOR_API_KEY=your_reactor_api_key_here
# Web app equivalents (apps/web/.env.local). The token URL is a public endpoint
# location, not a credential. Leave blank to try /api/reactor/token and Netlify.
NEXT_PUBLIC_ENABLE_ORBIS=false
NEXT_PUBLIC_REACTOR_TOKEN_URL=

# Development
NODE_ENV=development
DEBUG=runrealm:*

# Strava API Configuration
# Create an app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback