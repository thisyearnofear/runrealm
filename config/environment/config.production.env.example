# RunRealm Production Environment Configuration
# Use this as a reference for production deployment

# API Keys (These should be set as environment variables in your production environment)
MAPBOX_ACCESS_TOKEN=
GOOGLE_GEMINI_API_KEY=

# Strava API Configuration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=https://yourdomain.com/auth/strava/callback
STRAVA_VERIFY_TOKEN=

# ZetaChain Configuration
ZETACHAIN_RPC_URL=https://zetachain-athens-evm.blockpi.network/v1/rpc/public

# Zama Protocol FHEVM (confidential territory defense) — Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=
RUNREALM_CONFIDENTIAL_DEFENSE_ADDRESS=
RUNREALM_BOOST_ADDRESS=
# Phase 4 additive settlement escrow (marketplace + brand challenges).
# Web app binds via the NEXT_PUBLIC_ twin; blank = mirror-only marketplace.
RUNREALM_ESCROW_ADDRESS=
NEXT_PUBLIC_RUNREALM_ESCROW_ADDRESS=

# Contract Addresses (Mainnet - update when ready)
REALM_TOKEN_ADDRESS=
UNIVERSAL_CONTRACT_ADDRESS=

# --- Attestation oracle + network leaderboard (optional) ---
# SERVER ONLY, AND ONLY ON THE ORACLE DEPLOYMENT. The EIP-712 signing key.
# Use a dedicated key (never a funded wallet) and keep it out of NEXT_PUBLIC_*
# and the browser __ENV__ bridge.
#
# This is deliberately NOT an env var on the API deployment. The public API
# serves an unauthenticated POST /api/runs under CORS *, and before Phase 3
# the quorum key sat in the same environment as it — one env read away from a
# public write endpoint. Signing runs in its own process (server/oracle.js,
# the `oracle` container target, the `runrealm-oracle` worker) and the API
# deployment has no access to this value.
RUNREALM_ORACLE_PRIVATE_KEY=
# NEVER SET THIS IN PRODUCTION. It mounts the signer inside the public API
# process, undoing the whole split. It exists so local development can run
# one process instead of two.
RUNREALM_EMBEDDED_ORACLE=
# CLIENT. Comma-separated oracle base URLs, used for both signing
# (<url>/attestations/sign) and the network board
# (<url>/attestations/leaderboard). Public endpoints — they are not secrets.
RUNREALM_ATTESTATION_ORACLES=
# Web app equivalent, inlined at build time by Next.js. In a container/CI
# deploy this must be present when the web bundle is built, not only at
# runtime.
NEXT_PUBLIC_RUNREALM_ATTESTATION_ORACLES=
# SERVER ONLY. Ledger file path, read by BOTH the oracle (writes) and the
# public API (reads the board), so both deployments must point at the same
# persistent volume — a container's local disk is lost on every redeploy, and
# a board that empties itself on deploy is worse than an empty one.
# `off` disables persistence.
RUNREALM_LEDGER_PATH=/var/lib/runrealm/attestation-ledger.json

# Feature Flags
ENABLE_WEB3=true
ENABLE_AI_FEATURES=true
ENABLE_CROSS_CHAIN=true
AUTO_CONNECT_WALLET=true

# Production Settings
NODE_ENV=production
API_BASE_URL=https://yourdomain.com
PORT=3000