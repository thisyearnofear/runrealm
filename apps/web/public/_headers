# Cloudflare Pages response headers.
#
# This is the port of netlify.toml's `[[headers]]` blocks. Those were not
# incidental — three of them exist because something broke:
#
#   1. HTML is `no-store`. A static export emits an index.html that points at
#      content-hashed assets. Cache it and a deploy serves an index referencing
#      files that no longer exist, which is a white screen rather than a
#      stale-but-working page. The failure is silent and total.
#   2. Hashed assets are `immutable` for a year. Their names change when their
#      contents do, so a long cache costs nothing and saves a round trip on
#      every route chunk.
#   3. Explicit Content-Type on .js/.css/.json. Chrome and Brave have both
#      refused to execute a module served with the wrong type, and the
#      symptom — a blank app with no console error — is miserable to debug.
#
# Netlify-specific syntax (`for = "/*.js"`) is replaced with Cloudflare's
# splats, which use the same shape. Rules are first-match-wins in the order
# they appear, so the specific ones come before the general ones.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  # strict-origin-when-cross-origin, not no-referrer-when-downgrade. The desk
  # handoff puts a preview centre in the URL (`?preview={"lat":...}`), and
  # no-referrer-when-downgrade sends the *full* URL as Referer on any
  # https-to-https request -- including every basemap tile load. That handed
  # the tile provider the exact coordinates on every tile, regardless of the
  # rounding in geocoding-service. Cross-origin now gets the origin only.
  #
  # (Those tiles are OpenFreeMap + ESRI, not Mapbox -- see map-style.ts. The
  # policy was written when they were Mapbox, and stayed correct.)
  Referrer-Policy: strict-origin-when-cross-origin
  # Geolocation is the app; camera, microphone and interest-cohort are not.
  # Denying by default means a future dependency cannot quietly start asking.
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Content-Security-Policy -- REPORT-ONLY. Deliberately so.
  #
  # A misconfigured enforcing CSP on a static deploy white-screens the app,
  # and the only fix is another deploy. Report-only gives the identical
  # detection (every violation is logged to the devtools console) with none of
  # that risk, so we learn the real origin set before it can break anyone.
  #
  # To flip on: delete the `-Report-Only` suffix. Do that only after a QA
  # pass with an empty violations list covering: map + basemap switch, a
  # territory claim, a Strava connect, and one Reactor Orbis session.
  #
  # What each allowance is for:
  #   'unsafe-inline' (script)  Next.js static export inlines the RSC flight
  #                              payload; a static export has nowhere to put
  #                              a nonce.
  #   wasm-unsafe-eval          Zama FHE and the Reactor wasm both call
  #                              WebAssembly.compile at runtime.
  #   blob: (worker-src)        maplibre-gl v4 spins its workers up from blob
  #                              URLs. Plain 'unsafe-eval' is NOT granted.
  #   tiles.openfreemap.org     basemap style, tiles, glyphs, sprite.
  #   server.arcgisonline.com   the satellite raster style.
  #   api.mapbox.com            geocoding only, and only via the self-hosted
  #                              fallback in geocoding-service.ts -- the normal
  #                              path is the /api/geocode proxy, which holds
  #                              the token server-side. Tiles do not go here;
  #                              coordinates are rounded to ~110m before they
  #                              leave the device. (This line also said
  #                              "directions"; that path was deleted, and the
  #                              origin stayed because the fallback needs it.)
  #   api.reactor.inch          Reactor WebRTC signalling, and its wss.
  #   www.strava.com            activities API. The OAuth hop is a top-level
  #                              navigation, which CSP does not gate.
  #   *rpc*/ *infura* /etc.     chain RPC endpoints; wallets connect by
  #                              injecting a provider, so this is only ever
  #                              our own JSON-RPC calls.
  #   object-src 'none'         no <object>/<embed> anywhere in this app.
  #
  # Two deliberate omissions:
  #   - The API origin. `NEXT_PUBLIC_API_BASE_URL` is empty by default, which
  #     makes every API call same-origin and 'self' already covers it. If a
  #     deployment points it at a separate host, add that origin here -- the
  #     report-only console will name it exactly.
  #   - The block explorers. Those are `<a href>` links. CSP does not gate
  #     top-level navigation, so listing them would imply a control we do
  #     not have.
  #
  # Every origin above was read out of the source, not guessed. If one is
  # listed that no longer appears anywhere in the code, that is drift.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' wasm-unsafe-eval blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://server.arcgisonline.com; font-src 'self' data:; connect-src 'self' data: blob: https://tiles.openfreemap.org https://server.arcgisonline.com https://api.mapbox.com https://www.strava.com https://api.reactor.inch wss://api.reactor.inch https://mainnet.infura.io https://cloudflare-eth.com https://polygon-rpc.com https://rpc-amoy.polygon.technology https://ethereum-sepolia-rpc.publicnode.com https://zetachain-evm.blockpi.network https://zetachain-athens-evm.blockpi.network; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
  # X-XSS-Protection is deliberately absent. It was removed from every major
  # browser years ago, and browsers that still honour it only ever introduce
  # vulnerabilities into otherwise-correct pages.

# MIME types, before any caching rule can mask a wrong one.
/*.js
  Content-Type: application/javascript; charset=utf-8

/*.css
  Content-Type: text/css; charset=utf-8

/*.json
  Content-Type: application/json; charset=utf-8

/*.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

/*.map
  Content-Type: application/json; charset=utf-8

# Content-hashed build output: safe to cache forever, because the filename
# changes whenever the content does.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: never cached. See note 1 above.
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# The service worker must never be cached either, or a fix to it cannot reach
# anyone — which is the one file whose whole job is to be replaced.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon*
  Cache-Control: public, max-age=31536000, immutable
